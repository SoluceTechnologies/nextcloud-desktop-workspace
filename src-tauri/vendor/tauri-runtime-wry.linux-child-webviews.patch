+  target_os = "freebsd",
+  target_os = "netbsd",
+  target_os = "openbsd"
+))]
+fn layout_child(webview: &WebView) -> Option<(gtk::Layout, webkit2gtk::WebView)> {
+  use gtk::prelude::*;
+  let widget = webview.webview();
+  let layout = widget.parent()?.downcast::<gtk::Layout>().ok()?;
+  Some((layout, widget))
+}
+
+fn set_webview_bounds(webview: &WebView, bounds: wry::Rect) -> wry::Result<()> {
+  #[cfg(any(
+    target_os = "linux",
+    target_os = "dragonfly",
+    target_os = "freebsd",
+    target_os = "netbsd",
+    target_os = "openbsd"
+  ))]
+  if let Some((layout, widget)) = layout_child(webview) {
+    place_in_layout(&layout, &widget, bounds);
+    return Ok(());
+  }
+  webview.set_bounds(bounds)
+}
+
+// wry only reports a GTK webview's position under X11, (0, 0) otherwise.
+fn webview_bounds(webview: &WebView) -> wry::Result<wry::Rect> {
+  #[cfg(any(
+    target_os = "linux",
+    target_os = "dragonfly",
+    target_os = "freebsd",
+    target_os = "netbsd",
+    target_os = "openbsd"
+  ))]
+  if let Some((layout, widget)) = layout_child(webview) {
+    use gtk::prelude::*;
+    let (width, height) = widget.size_request();
+    return Ok(wry::Rect {
+      position: LogicalPosition::new(layout.child_x(&widget), layout.child_y(&widget)).into(),
+      size: LogicalSize::new(width, height).into(),
+    });
+  }
+  webview.bounds()
+}
