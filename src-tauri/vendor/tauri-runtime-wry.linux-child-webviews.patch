+// tao reports the configure-event size on Linux, which with client-side
+// decorations includes the header bar and the window shadow. GtkWindow::size
+// excludes both, i.e. it is the area child webviews actually get.
+fn content_size(window: &Window) -> PhysicalSize<u32> {
+  #[cfg(any(
+    target_os = "linux",
+    target_os = "dragonfly",
+    target_os = "freebsd",
+    target_os = "netbsd",
+    target_os = "openbsd"
+  ))]
+  {
+    use gtk::prelude::GtkWindowExt;
+    let (width, height) = window.gtk_window().size();
+    if width > 0 && height > 0 {
+      return LogicalSize::new(width as u32, height as u32).to_physical(window.scale_factor());
+    }
+  }
+  window.inner_size()
+}
