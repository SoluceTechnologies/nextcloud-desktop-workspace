+// Child webviews on Linux live in a gtk::Layout (see `create_webview`). Layout
+// allocates each child at its stored position with its size request, relative to
+// its own GdkWindow, so geometry survives relayouts and ignores CSD offsets, and
+// its own size request stays 0x0 so the window can still shrink.
+#[cfg(any(
+  target_os = "linux",
+  target_os = "dragonfly",
+  target_os = "freebsd",
+  target_os = "netbsd",
+  target_os = "openbsd"
+))]
+fn place_in_layout(layout: &gtk::Layout, widget: &webkit2gtk::WebView, bounds: wry::Rect) {
+  use gtk::prelude::*;
+  let scale = widget.scale_factor() as f64;
+  let (x, y): (i32, i32) = bounds.position.to_logical::<i32>(scale).into();
+  let (width, height): (i32, i32) = bounds.size.to_logical::<i32>(scale).into();
+  layout.move_(widget, x, y);
+  widget.set_size_request(width.max(1), height.max(1));
+  // Allocate now rather than on the layout's next pass: WebKit starts the web process
+  // right after the view is created and, without an allocation, sizes the page from
+  // the whole layout. The page then rendered its first frames at the window size.
+  if widget.is_visible() {
+    widget.preferred_size();
+    widget.size_allocate(&gtk::Allocation::new(x, y, width.max(1), height.max(1)));
+  }
+}
